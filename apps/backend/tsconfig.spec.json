{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "jest"
    ],
    "rootDir": ".",
    "noEmit": true,
    "incremental": false,
    "isolatedModules": true
  },
  "include": [
    "src/**/*",
    "jest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
